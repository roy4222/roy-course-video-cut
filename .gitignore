pipeline/v2/align_qc/qcq.list

# python / node
.venv/
venv/
**/__pycache__/
*.pyc
*.pyo
node_modules/
**/node_modules/

# browsers, models, caches
.browsers/
**/.browsers/
.cache/
**/.cache/
**/.kit/

# media and renders (episode text, json, srt stay)
*.mp4
*.wav
*.mp3
*.webm
*.jpg
*.jpeg
*.png
*.gif
*.mov
episodes/*/film/
episodes/*/out/
