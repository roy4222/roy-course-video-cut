# DejaVu Sans Mono woff2 files in the same folder are small and stay in git.
windows-kit/assets/fonts/NotoSansCJK*.woff2

# lemo-opuscar checkout (scripts/fetch_lemo_opuscar.sh). Not vendored.
third_party/

