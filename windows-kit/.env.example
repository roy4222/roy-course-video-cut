# Copy this file to .env (same folder) and fill in your own values. Never commit or share .env.
# OpenRouter API key for TTS (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-key-here

# Optional defaults (command-line flags override these)
# KIT_WORKERS=6            # parallel render workers; auto = min(8, CPU threads/4, RAM GB/6)
# KIT_NVENC=1              # encode with NVIDIA h264_nvenc
# KIT_WHISPER_DEVICE=cpu   # cpu | cuda | auto (cuda needs setup -Cuda)
# KIT_TTS_VOICE=Enceladus
# KIT_TTS_MODEL=google/gemini-3.8-flash-tts
